<?xml version="1.0" encoding="utf-8" ?>
<otrs_package version="1.0">
    <Name>Znuny-CopyTicketNumber</Name>
    <Version>1.0.0</Version>
    <Framework>6.5.x</Framework>
    <Vendor>Znuny GmbH</Vendor>
    <URL>https://znuny.com/</URL>
    <License>GNU AFFERO GENERAL PUBLIC LICENSE Version 3, November 2007</License>
    <Description Lang="en">This package adds a copy icon before the ticket number in the ticket zoom view, allowing agents to easily copy either the ticket number alone or the ticket number with title to the clipboard.</Description>
    <Description Lang="de">Dieses Paket fügt ein Kopier-Symbol vor der Ticket-Nummer in der Ticket-Zoom-Ansicht hinzu, wodurch Agenten entweder nur die Ticket-Nummer oder die Ticket-Nummer mit Titel einfach in die Zwischenablage kopieren können.</Description>
    <Filelist>
        <File Permission="660" Location="Kernel/Config/Files/XML/ZnunyCopyTicketNumber.xml"/>
        <File Permission="660" Location="Kernel/Language/de_ZnunyCopyTicketNumber.pm"/>
        <File Permission="660" Location="var/httpd/htdocs/js/Core.Agent.ZnunyCopyTicketNumber.js"/>
        <File Permission="660" Location="var/httpd/htdocs/skins/Agent/default/css/Core.ZnunyCopyTicketNumber.css"/>
    </Filelist>
</otrs_package>
